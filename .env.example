# Development only. Copy to .env; never commit credentials.
POSTGRES_DB=cocha
POSTGRES_USER=cocha
POSTGRES_PASSWORD=replace-with-a-local-password
# Host execution only; Compose builds its internal URL from POSTGRES_*.
# URL-encode special characters in the password when editing DATABASE_URL.
DATABASE_URL=postgresql+psycopg://cocha:replace-with-a-local-password@localhost:5432/cocha
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# Server-only. Live Gemini calls stay disabled until explicitly authorized.
GEMINI_API_KEY=
# Verified 2026-11-14: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.6-flash
# Project cap in USD. This is not a verified account balance.
GEMINI_BUDGET_USD=4
# Paid tier through 2026-12-31; rises to 1.50 / 7.50 on 2027-01-01.
GEMINI_INPUT_USD_PER_MILLION_TOKENS=0.75
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=3.75
GEMINI_PRICES_VERIFIED_ON=2026-11-14
GEMINI_PRICES_SOURCE_URL=https://ai.google.dev/gemini-api/docs/pricing
GEMINI_LEDGER_PATH=data/local/gemini-ledger.json
# In-memory WMS proxy limit for a single process.
WMS_RATE_LIMIT_REQUESTS=60
WMS_RATE_LIMIT_WINDOW_SECONDS=60
# Server-only GAMC WMS project key. Leave empty to keep the proxy unavailable.
GAMC_WMS_API_KEY=
# Shared secret for future write routes. Leave empty to keep writes disabled.
API_WRITE_TOKEN=
